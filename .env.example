# =============================================================
# JurisLex — variables d'environnement (exemple, sans secrets)
# Copier vers .env.local et renseigner les valeurs réelles.
# =============================================================

# --- Supabase (recommandé pour production / collab) ---
# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key

# Même URL côté scripts Python d'ingestion
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Service role : écriture ingestion uniquement. JAMAIS côté client, JAMAIS NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# --- Embeddings / LLM (recherche sémantique hybride + Q&A ultérieur) ---
# Sans clé : la recherche exacte et lexicale restent disponibles (index local ou FTS).
OPENAI_API_KEY=sk-your-openai-key
# Modèle chat pour Q&A sourcée (optionnel, défaut gpt-4o-mini)
JURISLEX_QA_MODEL=gpt-4o-mini

# --- Comportement application ---
# true = autorise l'affichage de données de démonstration UI si le corpus est vide
# false (défaut) = aucun mock juridique ; messages d'état honnêtes
NEXT_PUBLIC_DEMO_MODE=false

# --- Auth / dossiers (S3 + Cycle B) ---
# Secret HMAC pour cookies de session locale (min. 16 caractères en prod)
JURISLEX_SESSION_SECRET=change-me-to-a-long-random-string
# Fichier JSON local (users, matters, audit) — hors git via build/
JURISLEX_LOCAL_DB=build/local-db.json
# local | supabase | hybrid (Supabase puis repli local)
# supabase : migrations 002 + 003 + 004 + Auth email activé dans le projet
# En production : toujours `supabase` (pas de fallback local-db)
JURISLEX_AUTH_BACKEND=local

# --- Index local (fallback si Supabase non configuré) ---
# Chemin relatif à la racine du repo. Produit par scripts/02_extract.py
JURISLEX_CHUNKS_PATH=build/chunks.jsonl

# --- C1 worker / file d'ingestion ---
# Redis (docker compose service `redis`) — si absent, jobs restent en fichier local
REDIS_URL=redis://localhost:6379/0
JURISLEX_INGESTION_QUEUE=jurislex:ingestion:jobs
JURISLEX_INGESTION_JOBS_PATH=build/ingestion-jobs.json
